<div class="w-full px-2">
<div  class="w-full flex items-center justify-between">
    <span>Enable Bulk Add</span>
    
    <button
      type="button"
      role="switch"
      :aria-checked="$store.settings.bulkAddToCart"
      @click="$store.settings.toggleBulkAddToCart()"
      class="inline-flex h-[1.15rem] w-8 shrink-0 items-center rounded-full border border-transparent
             shadow-sm transition-colors duration-200 ease-in-out
             focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-2"
      :style="{ backgroundColor: $store.settings.bulkAddToCart  ? 'var(--color__background-primary)' : 'var(--color__background-shade-3)' }"
    >
      <span
        class="pointer-events-none block h-4 w-4 rounded-full shadow-lg ring-0
               transition-transform duration-200 ease-in-out"
        :class="$store.settings.bulkAddToCart  ? 'translate-x-[0.85rem]' : 'translate-x-0'"
        style="background-color: var(--color__background-tertiary);"
      ></span>
    </button>
    
  </div>
  <p class="type--smaller mb-0 opacity-50" >This provides you with a dedicated add to cart button instead of adding items to cart automatically.</p>
</div>