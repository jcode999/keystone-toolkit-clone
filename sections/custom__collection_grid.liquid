{% schema %}
{
	"name": "Custom Collection Grid",
    "tag":"section",
    "enabled_on": {
      "templates": ["*"]
    },
  "blocks": [
    {
      "type": "grid-card",
      "name":"Grid Card",
      "settings":[
        {
            "type": "url",
            "id": "card_link",
            "label": "Card Link"
        },
        {
          "type": "text",
          "id":"header",
          "label": "Header",
        },
        {
          "type":"color",
          "id": "heading_color",
          "label":"Heading Color",
        },
        {
          "type": "select",
          "id": "header_size",
          "label": "Header Size",
          "options": [
            {
              "value": "small",
              "label": "Small"
            },
            {
              "value": "medium",
              "label": "Medium"
            },
            {
              "value": "large",
              "label": "Large"
            },
            {
              "value": "xlarge",
              "label": "Extra Large"
            }
          ],
          "default": "medium"
        },

        {
          "type": "select",
          "id": "header_position",
          "label": "Header Position",
          "options": [
            {
              "value": "top-left",
              "label": "Top Left"
            },
            {
              "value": "top-center",
              "label": "Top Center"
            },
            {
              "value": "top-right",
              "label": "Top Right"
            },
            {
              "value": "bottom-left",
              "label": "Bottom Left"
            },
            {
              "value": "bottom-center",
              "label": "Bottom Center"
            },
            {
              "value": "bottom-right",
              "label": "Bottom Right"
            }
          ],
          "default": "top-left"
        },
        {
          "type":"image_picker",
          "id": "background_image",
          "label":"Background Image"
        },
        {
          "type": "select",
          "id": "background_size",
          "label": "Background Size",
          "options": [
            {
              "value": "cover",
              "label": "Cover"
            },
            {
              "value": "contain",
              "label": "Contain"
            }
          ],
          "default": "cover"
        },
        {
          "type": "range",
          "id": "column_span",
          "label": "Column Span",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 1
        },
        {
          "type": "range",
          "id": "row_span",
          "label": "Row Span",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 1
        }
      ]
    }
  ],
	"settings": [{
      "type": "range",
      "id": "columns",
      "label": "Number of columns",
      "min": 1,
      "max": 5,
      "step": 1,
      "default": 4,
      
    },
    {
        "type":"range",
        "id":"overlay_transperancy",
        "label": "Overlay Transperancy",
        "default":0.1,
        "step": 0.1,
        "min":0,
        "max":1,
    },
    {
      "type":"text",
      "id":"heading",
      "label":"Heading",
      
    }
  ],

	"presets": [
		{
			"name": "Custom Grid"
		}
	]
}
{% endschema %}
<section class="custom-section">
  <div>
  <div class="custom-collection-grid-heading">
    <h1>{{ section.settings.heading }}</h1>
  </div>
  
  <div class="custom-collection-grid-container">
    {% for block in section.blocks %}
      <a
        href="{{ block.settings.card_link }}"
        style="
          grid-column: span {{ block.settings.column_span }};
          grid-row: span {{ block.settings.row_span }};
        "
      >
        <div
          class="custom-collection-grid-item"
          {% comment %} style="
            background-image: url('{{ block.settings.background_image | image_url }}');
            background-size: {{ block.settings.background_size }};
          "
           {% endcomment %}
        >
          <img style="object-fit:cover;width:100%;height:100%;object-position:bottom;" src="{{ block.settings.background_image | image_url }}" width="100%" height="100%"
            
          >
          {% comment %} <div class="custom-grid-header header-{{ block.settings.header_position }} header-{{ block.settings.header_size }}">
            <h2
              style="color:{{ block.settings.heading_color }}
              "
            >
              {{ block.settings.header }}
            </h2>
          </div> {% endcomment %}
        </div>
      </a>
    {% endfor %}
  </div>
</div>
</section>
<style>
   .custom-section{
    padding: 1em;
    border-bottom: 1px solid gray;
    display:flex;
    align-items:center;
    justify-content:center;
  }
   {% comment %} .custom-collection-grid-heading{
    margin:1em 2em;
  } {% endcomment %}
   .custom-collection-grid-container {
  	display: grid;
  	grid-template-columns: repeat({{ section.settings.columns }}, 1fr);
  	/* grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); */
  	column-gap: 12px;
    row-gap:16px;
  	{% comment %} margin: 1em;
    padding:1em; {% endcomment %}
    
  }
  .custom-collection-grid-item::before {
  	content: '';
  	position: absolute;
  	top: 0;
  	left: 0;
  	width: 100%;
  	height: 100%;
  	background-color: rgba(0, 0, 0, {{ section.settings.overlay_transperancy }}); /* Black overlay with 50% opacity */
  	z-index: 0;
  	border-radius: 20px;
  }

  .custom-collection-grid-item {
  	
  	padding: none;
  	background-size: contain;
  	background-repeat: no-repeat;
  	background-position: center;
  	width: 100%;
  	height: 250px;
  	border: 1px solid rgb(253, 253, 253);
  	border-radius: 12px;
  	position: relative;
  	box-shadow: 0 4px 8px rgba(0, 0, 0.1, 0.1); /* X-offset, Y-offset, blur, spread, color */
  	transition: transform 0.3s ease;
    overflow:hidden;
  }
  .custom-collection-grid-item:hover {
  	transform: scale(1.01);
  }
     .custom-grid-header{
       position:absolute;
     }
     .header-top-left { top: 10px; left: 10px; }
     .header-top-center { top: 10px; left: 50%; transform: translateX(-50%); }
     .header-top-right { top: 10px; right: 10px; }
     .header-bottom-left { bottom: 10px; left: 10px; }
     .header-bottom-center { bottom: 10px; left: 50%; transform: translateX(-50%); }
     .header-bottom-right { bottom: 10px; right: 10px; }
     .header-small h2 {
     font-size: 1rem;
   }

   .header-medium h2 {
     font-size: 1.5rem;
   }

   .header-large h2 {
     font-size: 2rem;
   }

   .header-xlarge h2 {
     font-size: 3.5rem;
   }
     @media (max-width: 1024px) {
  	.custom-collection-grid-container {
  		grid-template-columns: repeat(4, 1fr);
  		/* 4 columns */
  	}
  }

  @media (max-width: 840px) {
  	.custom-collection-grid-container {
  		grid-template-columns: repeat(4, 1fr);
      column-gap:6px;
      row-gap:12px;
      padding:0px 1em;
  		/* 4 columns */
  	}
  }
     @media (max-width: 540px) {
      .custom-collection-grid-container {
        grid-template-columns: repeat(2, 1fr);
        column-gap:6px;
        row-gap:2em;
        padding:1em 0px;

      }
      .custom-collection-grid-item{
              height:150px;
      }

      .header-small h2 {
            font-size: 0.5rem;
          }
      
      .header-medium h2 {
            font-size: 1rem;
          }
      
      .header-large h2 {
            font-size: 1rem;
          }
      
      .header-xlarge h2 {
            font-size: 2.5rem;
      }

  }
</style>
