    "accordions_EdED3B": {
      "type": "accordions",
      "blocks": {
        "content_hqXGex": {
          "type": "content",
          "settings": {
            "heading": "Why can't I pay online?",
            "content": "<p>Currently, we have not integrated payment service into our online store. Please select Cash On Delivery (COD) as the payment method. We will send you an email with payment link once we receive your order.</p>",
            "icon": "info",
            "color_scheme": "minimal",
            "enable_open": true
          }
        },
        "content_DH6TnW": {
          "type": "content",
          "settings": {
            "heading": "About shipping?",
            "content": "<p>We provide two methods of delivering products to your location.</p><p>1) <strong>In Store Delivery</strong>: For customers within 50 miles radius with minimum order of $500.00 for a fee of $20.00</p><p>2) <strong>Nation Wide Shipping</strong>: For customers beyond 50 miles. **Please select <strong>Pick Up </strong>as the delivery option. We will still ship it.**</p><p>The Nation Wide shipping rates depend on the size of the order and is only calculated during the shipping phase. The shipping fees in the checkout section is just an estimation. The charge will be included in your final invoice.</p>",
            "icon": "info",
            "color_scheme": "minimal",
            "enable_open": false
          }
        },
        "content_yANWbb": {
          "type": "content",
          "settings": {
            "heading": "How am I notified about my order?",
            "content": "<p>You will receive an email notification from 545614@us.erply.io regarding your order status, whether it’s ready to be shipped or is ready for pick up.</p>",
            "icon": "info",
            "color_scheme": "minimal",
            "enable_open": false
          }
        },
        "content_Me8dbL": {
          "type": "content",
          "settings": {
            "heading": "What's your return policy?",
            "content": "<p>you can learn more about our return policy here</p><p><br/>https://united-wholesale.com/policies/refund-policy</p>",
            "icon": "info",
            "color_scheme": "minimal",
            "enable_open": false
          }
        },
        "content_FBmLYe": {
          "type": "content",
          "settings": {
            "heading": "Have any more questions?",
            "content": "<p>If you have any other questions, please feel free to contact us.</p><p><br/>Phone: +1-817-744-7989<br/>Email: contact@united-wholesale.com</p>",
            "icon": "info",
            "color_scheme": "minimal",
            "enable_open": false
          }
        }
      },
